{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/api/(.*)",
        "destination": "/api/index.js"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/privacy/delete-account",
        "destination": "/privacy/delete-account/index.html"
      },
      {
        "source": "/.well-known/(.*)",
        "destination": "/.well-known/$1"
      },
      {
        "source": "/app",
        "destination": "/app.html"
      },
      {
        "source": "/app/(.*)",
        "destination": "/app.html"
      }
    ],
    "fallback": [
      {
        "source": "/(.*)",
        "destination": "/app.html"
      }
    ]
  }
}

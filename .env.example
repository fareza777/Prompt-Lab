OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_PROVIDER=openrouter
# Free OpenRouter chain (Play Store / Vercel-safe). Failover in-app via FALLBACK_MODELS.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_PRIMARY_TIMEOUT_MS=55000
OPENROUTER_FALLBACK_TIMEOUT_MS=90000
OPENROUTER_FAST_PRIMARY_TIMEOUT_MS=20000
OPENROUTER_FAST_FALLBACK_TIMEOUT_MS=30000
OPENROUTER_BALANCED_PRIMARY_TIMEOUT_MS=40000
OPENROUTER_BALANCED_FALLBACK_TIMEOUT_MS=55000
OPENROUTER_PATIENT_PRIMARY_TIMEOUT_MS=55000
OPENROUTER_PATIENT_FALLBACK_TIMEOUT_MS=55000
OPENROUTER_OCR_MODEL=baidu/qianfan-ocr-fast:free
OPENROUTER_OCR_TIMEOUT_MS=45000
# Optional: NVIDIA / Groq / Cerebras keys (for future direct hops; routing above uses OpenRouter)
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# MiniMax (optional alternate)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=
MINIMAX_PRIMARY_TIMEOUT_MS=55000
# Optional local LiteLLM proxy (dev only — not reachable from Vercel/Play Store)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_PRIMARY_TIMEOUT_MS=120000
PORT=8787
APP_URL=https://prompt-lab.xyz
CORS_ORIGIN=https://prompt-lab.xyz
VITE_API_BASE=http://desktop-05stuq0.tail62c9b1.ts.net:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Google sign-in (Supabase Auth). Enabled by default; set false to hide the button.
# VITE_ENABLE_GOOGLE_AUTH=false
# One-time server setup — see README / npm run setup:google-auth
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=your-project-ref
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Lemon Squeezy — see playstore/LEMON_SQUEEZY_SETUP.md
VITE_WEB_CHECKOUT_PRO_URL=https://prom.lemonsqueezy.com/checkout/buy/ab217d1d-0715-4223-b741-ab06a2fd1068
VITE_WEB_CHECKOUT_BUSINESS_URL=https://prom.lemonsqueezy.com/checkout/buy/543907b2-919d-489f-b58c-eabae9aa12c0
# Webhook secret from Settings → Webhooks. Variant env may be checkout URL or UUID:
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID_PRO=https://prom.lemonsqueezy.com/checkout/buy/ab217d1d-0715-4223-b741-ab06a2fd1068
LEMON_SQUEEZY_VARIANT_ID_BUSINESS=https://prom.lemonsqueezy.com/checkout/buy/543907b2-919d-489f-b58c-eabae9aa12c0
VITE_WEB_MEMBERSHIP_EMAIL=support@prompt-lab.xyz
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Comma-separated emails with unlimited quota (also set on Vercel). DB role admin via phase-6 SQL.
SUPER_ACCOUNT_EMAILS=fajar.mreza@gmail.com
VITE_SUPER_ACCOUNT_EMAILS=fajar.mreza@gmail.com
# Admin → Publish globally: run supabase/phase-5-runtime-config.sql in Supabase SQL Editor once.
# Set true only for emergency (default: hard-fail quota DB writes)
QUOTA_RECORD_SOFT_FAIL=false

# Durable shared AI rate limiting (Upstash Redis or Vercel KV REST API).
# Set both in production. A partial/invalid pair fails closed without exposing credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional bounded REST timeout (10-10000 ms; default 2000).
RATE_LIMIT_KV_TIMEOUT_MS=2000
# Optional explicit enforcement outside NODE_ENV/VERCEL_ENV=production.
RATE_LIMIT_REQUIRE_DURABLE=false

# Google Play Billing verify (server) — see playstore/MONETIZATION_SETUP.md
GOOGLE_PLAY_PACKAGE_NAME=app.promptlab.twa
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

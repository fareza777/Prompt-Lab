{
  "name": "promptlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --use-system-ca server/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:smoke": "node scripts/smoke-ui.mjs",
    "build": "node scripts/generate-seo-route-js.mjs && node scripts/generate-sitemap.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "playstore:check": "node --test test/android-play-policy.test.js && node --use-system-ca scripts/check-playstore-readiness.mjs",
    "icons:generate": "node --use-system-ca scripts/generate-pwa-icons.mjs",
    "icons:android": "node --use-system-ca scripts/sync-android-icons.mjs",
    "playstore:assets": "node --use-system-ca scripts/generate-playstore-assets.mjs && node --use-system-ca scripts/capture-playstore-screenshots.mjs && node --use-system-ca scripts/frame-playstore-screenshots.mjs",
    "playstore:frame": "node --use-system-ca scripts/frame-playstore-screenshots.mjs",
    "playstore:promo": "node scripts/generate-promo-audio.mjs && remotion render playstore/remotion/index.jsx AIWorkStudioPromo playstore/assets/promo/AI-Work-Studio-remotion-1080p.mp4 --codec=h264 --crf=18",
    "playstore:build": "node --test test/android-play-policy.test.js && npm run icons:android && npm run build && npx cap sync android && cd android && gradlew bundleRelease",
    "setup:google-auth": "node scripts/setup-google-auth.mjs",
    "check:supabase": "node --use-system-ca scripts/check-supabase-setup.mjs",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@huggingface/transformers": "4.2.0",
    "@orama/orama": "3.1.18",
    "@supabase/supabase-js": "^2.106.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "6.0.3",
    "cors": "^2.8.6",
    "defuddle": "^0.19.4",
    "diff": "8.0.3",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "10.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.24.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "multer": "2.2.0",
    "openai": "^6.37.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "tiptap-markdown": "^0.9.0",
    "vite": "8.1.4",
    "xlsx": "0.18.5",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@remotion/cli": "^4.0.501",
    "playwright": "^1.59.1",
    "remotion": "^4.0.501"
  }
}

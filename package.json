{
  "name": "promptlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --use-system-ca server/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:smoke": "node scripts/smoke-ui.mjs",
    "build": "node scripts/generate-seo-route-js.mjs && node scripts/generate-sitemap.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "playstore:check": "node --use-system-ca scripts/check-playstore-readiness.mjs",
    "icons:generate": "node --use-system-ca scripts/generate-pwa-icons.mjs",
    "icons:android": "node --use-system-ca scripts/sync-android-icons.mjs",
    "playstore:assets": "node --use-system-ca scripts/generate-playstore-assets.mjs && node --use-system-ca scripts/capture-playstore-screenshots.mjs && node --use-system-ca scripts/frame-playstore-screenshots.mjs",
    "playstore:frame": "node --use-system-ca scripts/frame-playstore-screenshots.mjs",
    "playstore:promo": "node --use-system-ca scripts/create-promo-video.mjs",
    "playstore:build": "npm run icons:android && cd android-app && gradlew.bat bundleRelease",
    "setup:google-auth": "node scripts/setup-google-auth.mjs",
    "check:supabase": "node --use-system-ca scripts/check-supabase-setup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@vitejs/plugin-react": "6.0.3",
    "cors": "^2.8.6",
    "diff": "8.0.3",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "10.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.24.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "multer": "2.2.0",
    "openai": "^6.37.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "playwright": "^1.59.1"
  }
}
